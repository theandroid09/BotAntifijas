# Copia este archivo a .env y completa con credenciales NUEVAS (las anteriores quedaron expuestas)
TELEGRAM_TOKEN=
STATPAL_KEY=
ONLINESIM_API_KEY=
ADMIN_ID=
# Canal público opcional (el bot debe ser administrador): @mi_canal o -100xxxxxxxxxx
CANAL_ID=
# Recargas: soles:créditos separados por coma
YAPE_NUMERO=
YAPE_TITULAR=
PAQUETES=5:10,10:22,20:50
# Ruta de la base SQLite (en Docker usa un volumen)
DB_PATH=android.db
